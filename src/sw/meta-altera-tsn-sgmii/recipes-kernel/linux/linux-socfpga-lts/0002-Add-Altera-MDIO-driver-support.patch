From 61b66963b1d51492d58ea5821035f767b3c9566b Mon Sep 17 00:00:00 2001
From: "Vaidya, Mahesh R" <mahesh.r.vaidya@intel.com>
Date: Thu, 19 Jun 2025 06:45:51 -0700
Subject: [PATCH] Add Altera MDIO driver support.

Upstream-Status: Pending
Signed-off-by: Vaidya, Mahesh R <mahesh.r.vaidya@intel.com>
---
 drivers/net/mdio/Kconfig       |   8 ++
 drivers/net/mdio/Makefile      |   1 +
 drivers/net/mdio/mdio-altera.c | 144 +++++++++++++++++++++++++++++++++
 3 files changed, 153 insertions(+)
 create mode 100644 drivers/net/mdio/mdio-altera.c

diff --git a/drivers/net/mdio/Kconfig b/drivers/net/mdio/Kconfig
index 4a7a303be2f7..429a2545aa62 100644
--- a/drivers/net/mdio/Kconfig
+++ b/drivers/net/mdio/Kconfig
@@ -122,6 +122,14 @@ config MDIO_HISI_FEMAC
 	  This module provides a driver for the MDIO busses found in the
 	  Hisilicon SoC that have an Fast Ethernet MAC.
 
+config MDIO_ALTERA
+	tristate "Altera MDIO bus controller"
+	depends on HAS_IOMEM && OF_MDIO
+	select MDIO_DEVRES
+	help
+	  This module provides a driver for the MDIO busses found
+	  in the Altera SoC that have a Fast Ethernet MAC.
+
 config MDIO_I2C
 	tristate
 	depends on I2C
diff --git a/drivers/net/mdio/Makefile b/drivers/net/mdio/Makefile
index 1015f0db4531..db20bee11962 100644
--- a/drivers/net/mdio/Makefile
+++ b/drivers/net/mdio/Makefile
@@ -5,6 +5,7 @@ obj-$(CONFIG_ACPI_MDIO)		+= acpi_mdio.o
 obj-$(CONFIG_FWNODE_MDIO)	+= fwnode_mdio.o
 obj-$(CONFIG_OF_MDIO)		+= of_mdio.o
 
+obj-$(CONFIG_MDIO_ALTERA)		+= mdio-altera.o
 obj-$(CONFIG_MDIO_ASPEED)		+= mdio-aspeed.o
 obj-$(CONFIG_MDIO_BCM_IPROC)		+= mdio-bcm-iproc.o
 obj-$(CONFIG_MDIO_BCM_UNIMAC)		+= mdio-bcm-unimac.o
diff --git a/drivers/net/mdio/mdio-altera.c b/drivers/net/mdio/mdio-altera.c
new file mode 100644
index 000000000000..0d3504a8a2de
--- /dev/null
+++ b/drivers/net/mdio/mdio-altera.c
@@ -0,0 +1,144 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Altera mdio controller driver
+ *
+ * Copyright Altera Corporation (C) 2023-2024. All rights reserved
+ *
+ * This program is free software; you can redistribute it and/or modify it under
+ * the terms of the GNU General Public License version 2 as published by the
+ * Free Software Foundation; either version 2 of the License, or (at your
+ * option) any later version.
+ */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/netdevice.h>
+#include <linux/of_address.h>
+#include <linux/of_mdio.h>
+#include <linux/io.h>
+#include <linux/phy.h>
+#include <linux/platform_device.h>
+
+#define DRV_NAME "mdio-altr"
+
+#define 	ALTR_MDIO_CTRL		0x84
+#define   	ALTR_MDIO_CTRL_PHYAD	GENMASK(4, 0)
+#define   	ALTR_MDIO_CTRL_PRTAD	GENMASK(12, 8)
+#define   	ALTR_MDIO_CTRL_REGAD	GENMASK(31, 16)
+
+#define 	ALTR_MDIO_DATA		0x80
+
+
+struct altr_mdio_data {
+	void __iomem *base;
+};
+
+static void altr_mdio_configure(struct mii_bus *bus, u8 phyad, u8 devad, u16 regad)
+{
+	struct altr_mdio_data *bp = bus->priv;
+	u32 ctrl=0;
+
+	ctrl =    FIELD_PREP(ALTR_MDIO_CTRL_PHYAD, devad)
+		| FIELD_PREP(ALTR_MDIO_CTRL_REGAD, regad)
+		| FIELD_PREP(ALTR_MDIO_CTRL_PRTAD, phyad);
+
+	iowrite32(ctrl, bp->base + ALTR_MDIO_CTRL);
+
+	msleep(10);
+}
+
+
+static int altr_mdio_read_c45(struct mii_bus *bus, int phyaddr, int devad, int regad)
+{
+	struct altr_mdio_data *bp = bus->priv;
+	int data = 0;
+
+	altr_mdio_configure(bus, (u8)(phyaddr & 0x3F), (u8)(devad & 0x3F), (u16)(regad & 0xFFFF));
+	data = ioread32(bp->base + ALTR_MDIO_DATA);
+
+	return data;
+}
+
+static int altr_mdio_write_c45(struct mii_bus *bus, int phyaddr, int devad, int phyreg,
+                           u16 data)
+{
+	struct altr_mdio_data *bp = bus->priv;
+
+	altr_mdio_configure(bus, (u8)(phyaddr & 0x3F), (u8)(devad & 0x3F), (u16)(phyreg & 0xFFFF));
+	iowrite32(data, bp->base + ALTR_MDIO_DATA);
+
+	return 0;
+}
+
+static int altr_mdio_probe(struct platform_device *pdev)
+{
+	struct device_node *np = pdev->dev.of_node;
+	struct mii_bus *bus;
+	struct altr_mdio_data *bp;
+	int ret;
+
+	bus = devm_mdiobus_alloc_size(&pdev->dev, sizeof(*bp));
+	if (!bus)
+		return -ENOMEM;
+
+	bus->name = "altr_mii_bus";
+	bus->read = NULL;
+	bus->read_c45 = &altr_mdio_read_c45;
+	bus->write = NULL;
+	bus->write_c45 = &altr_mdio_write_c45;
+	snprintf(bus->id, MII_BUS_ID_SIZE, "%s%d", pdev->name,pdev->id);
+	bus->parent = &pdev->dev;
+	bp = bus->priv;
+	bp->base = devm_platform_ioremap_resource(pdev, 0);
+
+	if (IS_ERR(bp->base))
+		return PTR_ERR(bp->base);
+
+	platform_set_drvdata(pdev, bus);
+	if (np) {
+		/* try dt phy registration */
+		ret = of_mdiobus_register(bus, np);
+
+		if (ret) {
+			dev_err(&pdev->dev, "Cannot register Altera MDIO bus!\n");
+			return ret;
+		}
+	} else {
+		dev_err(&pdev->dev, "Invalid node Altera MDIO bus!\n");
+		return -ENOMEM;
+	}
+	return 0;
+}
+
+static void altr_mdio_remove(struct platform_device *pdev)
+{
+	struct mii_bus *bus = platform_get_drvdata(pdev);
+
+	mdiobus_unregister(bus);
+	mdiobus_free(bus);
+}
+
+static const struct of_device_id altr_mdio_dt_ids[] = {
+	{ .compatible = "altr, altr-mdio" },
+	{},
+};
+MODULE_DEVICE_TABLE(of, altr_mdio_dt_ids);
+
+static struct platform_driver altr_mdio_driver = {
+	.probe = altr_mdio_probe,
+	.remove = altr_mdio_remove,
+	.driver = {
+		.name = DRV_NAME,
+		.of_match_table = altr_mdio_dt_ids,
+	},
+};
+
+module_platform_driver(altr_mdio_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Altera MDIO driver");
+MODULE_AUTHOR("Altera");
+
+
