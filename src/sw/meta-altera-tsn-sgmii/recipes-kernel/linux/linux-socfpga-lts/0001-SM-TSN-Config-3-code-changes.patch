--- /dev/null
+++ b/drivers/net/ethernet/stmicro/stmmac/mrphy.c
@@ -0,0 +1,158 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Copyright Intel Corporation (C) 2023. All rights reserved.
+ *
+ * Author: Mahesh R Vaidya <mahesh.r.vaidya@intel.com>
