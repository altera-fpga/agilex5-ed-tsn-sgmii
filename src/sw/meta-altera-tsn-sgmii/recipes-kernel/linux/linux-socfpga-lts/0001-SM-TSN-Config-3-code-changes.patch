@@ -653,6 +916,16 @@ static int socfpga_dwmac_probe(struct platform_device *pdev)
 	ndev = platform_get_drvdata(pdev);
 	stpriv = netdev_priv(ndev);
 
+        if(dwmac->mrphy.mrphy_base) {
