              </ipxact:resets>
              <ipxact:bitWidth>1</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>cfg_rxbit_cntr_pma</ipxact:name>
              <ipxact:description>&lt;b&gt;When set, async pulse is generated when UX Rx Deterministic Latency counter counts to 0.&lt;/b&gt;</ipxact:description>
              <ipxact:bitOffset>25</ipxact:bitOffset>
              <ipxact:resets>
