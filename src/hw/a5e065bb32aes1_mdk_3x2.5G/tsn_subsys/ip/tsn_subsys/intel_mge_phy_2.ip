              <ipxact:bitOffset>0</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x00000</ipxact:value>
                  <ipxact:mask>0x3ffff</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>18</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>cfg_sel_rxbit_adder</ipxact:name>
              <ipxact:description>&lt;b&gt;UX Rx Deterministic Latency counter increment, which is equal to data bus width.&lt;/b&gt;</ipxact:description>
              <ipxact:bitOffset>18</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x0</ipxact:value>
                  <ipxact:mask>0x7</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>3</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>cfg_rst_rxbit_cntr</ipxact:name>
              <ipxact:description>&lt;b&gt;UX Rx Deterministic Latency counter reset &lt;/b&gt;</ipxact:description>
              <ipxact:bitOffset>24</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x0</ipxact:value>
                  <ipxact:mask>0x1</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>1</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>cfg_rxbit_cntr_pma</ipxact:name>
              <ipxact:description>&lt;b&gt;When set, async pulse is generated when UX Rx Deterministic Latency counter counts to 0.&lt;/b&gt;</ipxact:description>
              <ipxact:bitOffset>25</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x0</ipxact:value>
                  <ipxact:mask>0x1</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>1</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
          </ipxact:register>
          <ipxact:register>
            <ipxact:name>ux2_q_dl_ctrl_b</ipxact:name>
            <ipxact:description>&lt;b&gt;reg_ux2_q_dl_ctrl_b &lt;/b&gt;</ipxact:description>
            <ipxact:addressOffset>0x200c</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:register>
          <ipxact:register>
            <ipxact:name>ux3_q_lane_number</ipxact:name>
            <ipxact:description>&lt;b&gt;reg_ux3_q_lane_number &lt;/b&gt;</ipxact:description>
            <ipxact:addressOffset>0x3000</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-only</ipxact:access>
            <ipxact:field>
              <ipxact:name>cfg_lane_number</ipxact:name>
              <ipxact:description>&lt;b&gt;UX lane_number&lt;/b&gt;</ipxact:description>
              <ipxact:bitOffset>0</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x00000003</ipxact:value>
                  <ipxact:mask>0xffffffff</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>32</ipxact:bitWidth>
              <ipxact:access>read-only</ipxact:access>
            </ipxact:field>
          </ipxact:register>
          <ipxact:register>
            <ipxact:name>ux3_q_dl_ctrl_a</ipxact:name>
            <ipxact:description>&lt;b&gt;reg_ux3_q_dl_ctrl_a &lt;/b&gt;</ipxact:description>
            <ipxact:addressOffset>0x3008</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-write</ipxact:access>
            <ipxact:field>
              <ipxact:name>cfg_rx_lat_bit_for_async</ipxact:name>
              <ipxact:description>&lt;b&gt;UX Rx Deterministic Latency counter value for async pulse generation &lt;/b&gt;</ipxact:description>
              <ipxact:bitOffset>0</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x00000</ipxact:value>
                  <ipxact:mask>0x3ffff</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>18</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>cfg_sel_rxbit_adder</ipxact:name>
              <ipxact:description>&lt;b&gt;UX Rx Deterministic Latency counter increment, which is equal to data bus width.&lt;/b&gt;</ipxact:description>
              <ipxact:bitOffset>18</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x0</ipxact:value>
                  <ipxact:mask>0x7</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>3</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>cfg_rst_rxbit_cntr</ipxact:name>
              <ipxact:description>&lt;b&gt;UX Rx Deterministic Latency counter reset &lt;/b&gt;</ipxact:description>
              <ipxact:bitOffset>24</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x0</ipxact:value>
                  <ipxact:mask>0x1</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>1</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>cfg_rxbit_cntr_pma</ipxact:name>
              <ipxact:description>&lt;b&gt;When set, async pulse is generated when UX Rx Deterministic Latency counter counts to 0.&lt;/b&gt;</ipxact:description>
              <ipxact:bitOffset>25</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x0</ipxact:value>
                  <ipxact:mask>0x1</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>1</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
          </ipxact:register>
          <ipxact:register>
            <ipxact:name>ux3_q_dl_ctrl_b</ipxact:name>
            <ipxact:description>&lt;b&gt;reg_ux3_q_dl_ctrl_b &lt;/b&gt;</ipxact:description>
            <ipxact:addressOffset>0x300c</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:register>
        </ipxact:registerFile>
        <ipxact:registerFile>
          <ipxact:name>intel_directphy_sip_csr</ipxact:name>
          <ipxact:addressOffset>0x800</ipxact:addressOffset>
          <ipxact:range>0x20</ipxact:range>
          <ipxact:register>
            <ipxact:name>gui_option</ipxact:name>
            <ipxact:description>&lt;b&gt;Device &amp; IP variant&lt;/b&gt;. Includes the following fields:&lt;br&gt;
        &lt;ul&gt;
            &lt;li&gt; line_rate &lt;/li&gt;
            &lt;li&gt; xcvr_type&lt;/li&gt;
            &lt;li&gt; modulation_type&lt;/li&gt;
            &lt;li&gt; duplex_mode&lt;/li&gt;
            &lt;li&gt; number of xcvrs &lt;/li&gt;
            &lt;li&gt; fec_enable&lt;/li&gt;
        &lt;/ul&gt;</ipxact:description>
            <ipxact:addressOffset>0x0</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-only</ipxact:access>
            <ipxact:field>
              <ipxact:name>line_rate_p1ghz</ipxact:name>
              <ipxact:description>&lt;b&gt;Line rate in 0.1GHz&lt;/b&gt;&lt;p&gt;Line datarate in 0.1GHz per transceiver.&lt;/p&gt;</ipxact:description>
              <ipxact:bitOffset>0</ipxact:bitOffset>
              <ipxact:bitWidth>12</ipxact:bitWidth>
              <ipxact:access>read-only</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>xcvr_type</ipxact:name>
              <ipxact:description>&lt;b&gt;Xcvr type&lt;/b&gt;&lt;p&gt;0:GTS tranceiver&lt;/p&gt;</ipxact:description>
              <ipxact:bitOffset>12</ipxact:bitOffset>
              <ipxact:bitWidth>1</ipxact:bitWidth>
              <ipxact:access>read-only</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>modulation_type</ipxact:name>
              <ipxact:description>&lt;b&gt;Modulation type&lt;/b&gt;&lt;p&gt;0:NRZ&lt;/p&gt;</ipxact:description>
              <ipxact:bitOffset>13</ipxact:bitOffset>
              <ipxact:bitWidth>1</ipxact:bitWidth>
              <ipxact:access>read-only</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>duplex_mode</ipxact:name>
              <ipxact:description>&lt;b&gt;Duplex mode&lt;/b&gt;&lt;p&gt;0:Not used, 1:RX simplex, 2:TX simplex, 3:TX/RX duplex, 4:Dual-Simplex&lt;/p&gt;</ipxact:description>
              <ipxact:bitOffset>14</ipxact:bitOffset>
              <ipxact:bitWidth>3</ipxact:bitWidth>
              <ipxact:access>read-only</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>num_xcvr</ipxact:name>
              <ipxact:description>&lt;b&gt;Number of transceivers&lt;/b&gt;&lt;p&gt;Number of transceivers per system&lt;/p&gt;</ipxact:description>
              <ipxact:bitOffset>17</ipxact:bitOffset>
              <ipxact:bitWidth>4</ipxact:bitWidth>
              <ipxact:access>read-only</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>fec_enable</ipxact:name>
              <ipxact:description>&lt;b&gt;FEC Enabled?&lt;/b&gt;&lt;p&gt;0:FEC is disabled, 1:FEC is enabled&lt;/p&gt;</ipxact:description>
              <ipxact:bitOffset>21</ipxact:bitOffset>
              <ipxact:bitWidth>1</ipxact:bitWidth>
              <ipxact:access>read-only</ipxact:access>
            </ipxact:field>
          </ipxact:register>
          <ipxact:register>
            <ipxact:name>dhpy_scratch</ipxact:name>
            <ipxact:description>&lt;b&gt; Scratch Register&lt;/b&gt;&lt;p&gt;32 bits of scratch register space for testing&lt;/p&gt;</ipxact:description>
            <ipxact:addressOffset>0x4</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-write</ipxact:access>
            <ipxact:field>
              <ipxact:name>scratch</ipxact:name>
              <ipxact:description>&lt;b&gt;Register to test the basic read and write functionality&lt;/b&gt;</ipxact:description>
              <ipxact:bitOffset>0</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x00000000</ipxact:value>
                  <ipxact:mask>0xffffffff</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>32</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
          </ipxact:register>
          <ipxact:register>
            <ipxact:name>dphy_reset</ipxact:name>
            <ipxact:description>&lt;b&gt;IP Soft Reset Register&lt;/b&gt;&lt;p&gt;Includes the following:
            &lt;ul&gt;
                &lt;li&gt; soft_tx_rst (Soft TX Reset)&lt;/li&gt;
                &lt;li&gt; soft_rx_rst (Soft RX Reset)&lt;/li&gt;
                &lt;li&gt; tx_rst_ovr  (TX Reset Override)&lt;/li&gt;
                &lt;li&gt; rx_rst_ovr  (RX Reset Override)&lt;/li&gt;
            &lt;/ul&gt;&lt;/p&gt;</ipxact:description>
            <ipxact:addressOffset>0x8</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-write</ipxact:access>
            <ipxact:field>
              <ipxact:name>soft_tx_rst</ipxact:name>
              <ipxact:description>&lt;b&gt;Soft TX Reset&lt;/b&gt;&lt;p&gt;1:Reset the TX datapath if tx_rst_ovr is also set&lt;/p&gt;</ipxact:description>
              <ipxact:bitOffset>0</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x0</ipxact:value>
                  <ipxact:mask>0x1</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>1</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>soft_rx_rst</ipxact:name>
              <ipxact:description>&lt;b&gt;Soft RX Reset&lt;/b&gt;&lt;p&gt;1:Reset the RX datapath if tx_rst_ovr is also set&lt;/p&gt;</ipxact:description>
              <ipxact:bitOffset>1</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x0</ipxact:value>
                  <ipxact:mask>0x1</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>1</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>tx_rst_ovr</ipxact:name>
              <ipxact:description>&lt;b&gt;TX Reset Override&lt;/b&gt;&lt;p&gt;0:Use TX Reset from user interface, 1:use Soft TX Reset&lt;/p&gt;</ipxact:description>
              <ipxact:bitOffset>4</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x0</ipxact:value>
                  <ipxact:mask>0x1</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>1</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>rx_rst_ovr</ipxact:name>
              <ipxact:description>&lt;b&gt;RX Reset Override&lt;/b&gt;&lt;p&gt;0:Use RX Reset from user interface, 1:use Soft RX Reset&lt;/p&gt;</ipxact:description>
              <ipxact:bitOffset>5</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x0</ipxact:value>
                  <ipxact:mask>0x1</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>1</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
          </ipxact:register>
          <ipxact:register>
            <ipxact:name>dphy_reset_status</ipxact:name>
            <ipxact:description>&lt;b&gt;IP Reset, tx_ready, rx_ready Status Register&lt;/b&gt;. Not sticky bit. Includes the following fields:&lt;br&gt;
        &lt;ul&gt;
            &lt;li&gt; tx_rst_ack_n&lt;/li&gt;
            &lt;li&gt; rx_rst_ack_n&lt;/li&gt;
            &lt;li&gt; tx_ready&lt;/li&gt;
            &lt;li&gt; rx_ready &lt;/li&gt;
        &lt;/ul&gt;</ipxact:description>
            <ipxact:addressOffset>0xc</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-only</ipxact:access>
            <ipxact:field>
              <ipxact:name>tx_rst_ack_n</ipxact:name>
              <ipxact:description>&lt;b&gt;TX Reset acknowledge. Active high (either the hard tx reset or the soft_tx_rst )&lt;/b&gt;&lt;p&gt;1:acknowledge the reset completed.&lt;/p&gt;</ipxact:description>
              <ipxact:bitOffset>0</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x0</ipxact:value>
                  <ipxact:mask>0x1</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>1</ipxact:bitWidth>
              <ipxact:access>read-only</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>rx_rst_ack_n</ipxact:name>
              <ipxact:description>&lt;b&gt;RX Reset acknowledge. Active high (either the hard rx reset or the soft_rx_rst )&lt;/b&gt;&lt;p&gt;1:acknowledge the reset completed.&lt;/p&gt;</ipxact:description>
              <ipxact:bitOffset>1</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x0</ipxact:value>
                  <ipxact:mask>0x1</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>1</ipxact:bitWidth>
              <ipxact:access>read-only</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>tx_ready</ipxact:name>
              <ipxact:description>&lt;b&gt;tx_ready state&lt;/b&gt;&lt;p&gt;Current state of TX side:
                &lt;ul&gt;
                    &lt;li&gt; [0]: Not ready to accept user data&lt;/li&gt;
                    &lt;li&gt; [1]: Ready to send user data, indicates tx pll locked and data path reset done&lt;/li&gt;
                &lt;/ul&gt;&lt;/p&gt;</ipxact:description>
              <ipxact:bitOffset>4</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x0</ipxact:value>
                  <ipxact:mask>0x1</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>1</ipxact:bitWidth>
              <ipxact:access>read-only</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>rx_ready</ipxact:name>
              <ipxact:description>&lt;b&gt;rx_ready state&lt;/b&gt;&lt;p&gt;Current state of RX side:
                &lt;ul&gt;
                    &lt;li&gt; [0]: Not ready to recover line data to paralell interface&lt;/li&gt;
                    &lt;li&gt; [1]: Ready to deliver recovered line data to parallel interface, indicates rx CDR locked and data path reset done&lt;/li&gt;
                &lt;/ul&gt;&lt;/p&gt;</ipxact:description>
              <ipxact:bitOffset>5</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x0</ipxact:value>
                  <ipxact:mask>0x1</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>1</ipxact:bitWidth>
              <ipxact:access>read-only</ipxact:access>
            </ipxact:field>
          </ipxact:register>
          <ipxact:register>
            <ipxact:name>phy_tx_pll_locked</ipxact:name>
            <ipxact:description>&lt;b&gt;TX PLL locked&lt;/b&gt;&lt;p&gt;TX PLL used by the corresponding physical lane is locked&lt;/p&gt;</ipxact:description>
            <ipxact:addressOffset>0x10</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-only</ipxact:access>
            <ipxact:field>
              <ipxact:name>tx_pll_locked</ipxact:name>
              <ipxact:description>&lt;b&gt;TX PLL Locked&lt;/b&gt;&lt;p&gt;1=TX PLL used by this lane physical lane is locked&lt;/p&gt;</ipxact:description>
              <ipxact:bitOffset>0</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x0000</ipxact:value>
                  <ipxact:mask>0xffff</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>16</ipxact:bitWidth>
              <ipxact:access>read-only</ipxact:access>
            </ipxact:field>
          </ipxact:register>
          <ipxact:register>
            <ipxact:name>phy_rx_cdr_locked</ipxact:name>
            <ipxact:description>&lt;b&gt;RX CDR PLL locked&lt;/b&gt;&lt;p&gt;One bit per physical lane to indicate whether or not each CDR has succesfully locked to the reference clock or data. &lt;/p&gt;</ipxact:description>
            <ipxact:addressOffset>0x14</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-only</ipxact:access>
            <ipxact:field>
              <ipxact:name>rx_cdr_locked</ipxact:name>
              <ipxact:description>&lt;b&gt;CDR PLL locked&lt;/b&gt;&lt;p&gt;1:Corresponding physical lane's CDR has locked to reference&lt;/p&gt;</ipxact:description>
              <ipxact:bitOffset>0</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x0000</ipxact:value>
                  <ipxact:mask>0xffff</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>16</ipxact:bitWidth>
              <ipxact:access>read-only</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>rx_cdr_locked2data</ipxact:name>
              <ipxact:description>&lt;b&gt;CDR PLL locked to data&lt;/b&gt;&lt;p&gt;1:Corresponding physical lane's CDR has locked to data&lt;/p&gt;</ipxact:description>
              <ipxact:bitOffset>16</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x0000</ipxact:value>
                  <ipxact:mask>0xffff</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>16</ipxact:bitWidth>
              <ipxact:access>read-only</ipxact:access>
            </ipxact:field>
          </ipxact:register>
          <ipxact:register>
            <ipxact:name>src_ctrl</ipxact:name>
            <ipxact:description>&lt;b&gt; Control to SRC to ignore locked2data and clear rx and tx alarms&lt;/b&gt;</ipxact:description>
            <ipxact:addressOffset>0x18</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:register>
          <ipxact:register>
            <ipxact:name>src_alarms</ipxact:name>
            <ipxact:description>&lt;b&gt; SRC Alarm Status&lt;/b&gt;</ipxact:description>
            <ipxact:addressOffset>0x1c</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:register>
        </ipxact:registerFile>
        <ipxact:registerFile>
          <ipxact:name>intel_reset_control_csr</ipxact:name>
          <ipxact:addressOffset>0x10000</ipxact:addressOffset>
          <ipxact:range>0x1c</ipxact:range>
          <ipxact:register>
            <ipxact:name>src_user_reg0</ipxact:name>
            <ipxact:description>&lt;b&gt;Ignore RX Lock2Data&lt;/b&gt;. Includes the following fields:&lt;br&gt;
        &lt;ul&gt;
            &lt;li&gt; ignore_rx_lock2data &lt;/li&gt;
        &lt;/ul&gt;</ipxact:description>
            <ipxact:addressOffset>0x18</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-write</ipxact:access>
            <ipxact:field>
              <ipxact:name>ignore_rx_lock2data</ipxact:name>
              <ipxact:description>&lt;b&gt;Set ignore_rx_lock2data&lt;/b&gt;&lt;p&gt;0: Dont ignore  1: Ignore&lt;/p&gt;</ipxact:description>
              <ipxact:bitOffset>0</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x0</ipxact:value>
                  <ipxact:mask>0x1</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>1</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
          </ipxact:register>
        </ipxact:registerFile>
      </ipxact:addressBlock>
      <ipxact:addressUnitBits>8</ipxact:addressUnitBits>
    </ipxact:memoryMap>
  </ipxact:memoryMaps>
