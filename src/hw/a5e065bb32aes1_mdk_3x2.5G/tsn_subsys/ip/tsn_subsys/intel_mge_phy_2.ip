            <ipxact:displayName>serdes_lane_ana_pll_lf REG</ipxact:displayName>
            <ipxact:description>SRDS_IP_PLLLCFAST::serdes_lane_ana_pll_lf</ipxact:description>
            <ipxact:addressOffset>0x8</ipxact:addressOffset>
