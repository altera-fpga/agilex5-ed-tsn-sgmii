          <ipxact:value>bonusData 
{
   element clock_in
   {
      datum _sortIndex
      {
         value = "0";
         type = "int";
      }
   }
   element intel_agilex_5_soc_0
   {
      datum _sortIndex
      {
         value = "2";
         type = "int";
      }
   }
   element mm_bridge_0
   {
      datum _sortIndex
      {
         value = "3";
         type = "int";
      }
   }
   element reset_in
   {
      datum _sortIndex
      {
         value = "1";
         type = "int";
      }
   }
}
</ipxact:value>
