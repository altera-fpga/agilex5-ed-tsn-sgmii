GROUPBEGIN
   NAME: MUX_DUT_PARAM
   DESC: DUT parameters
   TOP:  mux

   +PARAM: DEVICE_FAMILY               string  "Stratix V"    Device Family (example)
   +PARAM: BIT_RATE                    untyped 10137          Bit Rate (example)
GROUPEND

GROUPBEGIN
   NAME: MUX_CRU_PARAM
   DESC: CRU parameters
   TOP:  altuvm_cru_if

   +PARAM: CLK_OUT_NUM                 untyped  4        Number of clocks to be driven
   +PARAM: CLK_IN_NUM                  untyped  0        Number of clocks received from DUT
   +PARAM: RST_OUT_NUM                 untyped  4        Number of resets to be driven
   +PARAM: RST_IN_NUM                  untyped  0        Number of resets received from DUT
GROUPEND

GROUPBEGIN
   NAME: MUX_RTB_PARAM
   DESC: MUX RTB Parameters
   TOP:  mux_rtb

   +GROUP: MUX_DUT_PARAM
   +GROUP: MUX_CRU_PARAM
GROUPEND
