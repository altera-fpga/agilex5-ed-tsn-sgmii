   task insert_serial_skew(seq_var m_seq_var);
     case(m_seq_var.num_p_lanes)
       1: begin
         if(m_seq_var.plane_0 == 0) begin
           p_sequencer.env.ts_tasks_if.do_drv_cfg(`ETH_SERIAL_SKEW_LANE0, m_seq_var.serial_skew_0);
         end
         else if(m_seq_var.plane_0 == 1) begin
           p_sequencer.env.ts_tasks_if.do_drv_cfg(`ETH_SERIAL_SKEW_LANE1, m_seq_var.serial_skew_1);
         end
         else if(m_seq_var.plane_0 == 2) begin
           p_sequencer.env.ts_tasks_if.do_drv_cfg(`ETH_SERIAL_SKEW_LANE2, m_seq_var.serial_skew_2);
         end
         else if(m_seq_var.plane_0 == 3) begin
           p_sequencer.env.ts_tasks_if.do_drv_cfg(`ETH_SERIAL_SKEW_LANE3, m_seq_var.serial_skew_3);
         end
       end
       2: begin
         if((m_seq_var.plane_0 == 0) || (m_seq_var.plane_1 == 0)) begin
           p_sequencer.env.ts_tasks_if.do_drv_cfg(`ETH_SERIAL_SKEW_LANE0, m_seq_var.serial_skew_0);
         end
         if((m_seq_var.plane_0 == 1) || (m_seq_var.plane_1 == 1)) begin
           p_sequencer.env.ts_tasks_if.do_drv_cfg(`ETH_SERIAL_SKEW_LANE1, m_seq_var.serial_skew_1);
         end
         if((m_seq_var.plane_0 == 2) || (m_seq_var.plane_1 == 2)) begin
           p_sequencer.env.ts_tasks_if.do_drv_cfg(`ETH_SERIAL_SKEW_LANE2, m_seq_var.serial_skew_2);
         end
         if((m_seq_var.plane_0 == 3) || (m_seq_var.plane_1 == 3)) begin
           p_sequencer.env.ts_tasks_if.do_drv_cfg(`ETH_SERIAL_SKEW_LANE3, m_seq_var.serial_skew_3);
         end
       end
       3: begin
         if((m_seq_var.plane_0 == 0) || (m_seq_var.plane_1 == 0) ||  (m_seq_var.plane_2 == 0)) begin
           p_sequencer.env.ts_tasks_if.do_drv_cfg(`ETH_SERIAL_SKEW_LANE0, m_seq_var.serial_skew_0);
         end
         if((m_seq_var.plane_0 == 1) || (m_seq_var.plane_1 == 1) ||  (m_seq_var.plane_2 == 1)) begin
           p_sequencer.env.ts_tasks_if.do_drv_cfg(`ETH_SERIAL_SKEW_LANE1, m_seq_var.serial_skew_1);
         end
         if((m_seq_var.plane_0 == 2) || (m_seq_var.plane_1 == 2) ||  (m_seq_var.plane_2 == 2)) begin
           p_sequencer.env.ts_tasks_if.do_drv_cfg(`ETH_SERIAL_SKEW_LANE2, m_seq_var.serial_skew_2);
         end
         if((m_seq_var.plane_0 == 3) || (m_seq_var.plane_1 == 3) ||  (m_seq_var.plane_2 == 3)) begin
           p_sequencer.env.ts_tasks_if.do_drv_cfg(`ETH_SERIAL_SKEW_LANE3, m_seq_var.serial_skew_3);
         end
       end
       4: begin
         if((m_seq_var.plane_0 == 0) || (m_seq_var.plane_1 == 0) ||  (m_seq_var.plane_2 == 0) || (m_seq_var.plane_3 == 0)) begin
           p_sequencer.env.ts_tasks_if.do_drv_cfg(`ETH_SERIAL_SKEW_LANE0, m_seq_var.serial_skew_0);
         end
         if((m_seq_var.plane_0 == 1) || (m_seq_var.plane_1 == 1) ||  (m_seq_var.plane_2 == 1) || (m_seq_var.plane_3 == 1)) begin
           p_sequencer.env.ts_tasks_if.do_drv_cfg(`ETH_SERIAL_SKEW_LANE1, m_seq_var.serial_skew_1);
         end
         if((m_seq_var.plane_0 == 2) || (m_seq_var.plane_1 == 2) ||  (m_seq_var.plane_2 == 2) || (m_seq_var.plane_3 == 2)) begin
           p_sequencer.env.ts_tasks_if.do_drv_cfg(`ETH_SERIAL_SKEW_LANE2, m_seq_var.serial_skew_2);
         end
         if((m_seq_var.plane_0 == 3) || (m_seq_var.plane_1 == 3) ||  (m_seq_var.plane_2 == 3) || (m_seq_var.plane_3 == 3)) begin
           p_sequencer.env.ts_tasks_if.do_drv_cfg(`ETH_SERIAL_SKEW_LANE3, m_seq_var.serial_skew_3);
         end
       end
     endcase
   endtask :insert_serial_skew

   task insert_invalid_sync_hdr_callback(int num_err);
     `uvm_info("inside task","entering inv sh, with enable_inj=0 & err_inj=0",UVM_MEDIUM);
     `ifdef ETH_MULTI_PORT
     p_sequencer.env.usxgmii_66_err_callback.enable_injection = 1;
     p_sequencer.env.usxgmii_66_err_callback.err_inj_cnt = 0;
     `uvm_info("inside task",$sformatf("changed enable_injection : %0d and err_inf_cnt: %0d",p_sequencer.env.usxgmii_66_err_callback.enable_injection,p_sequencer.env.usxgmii_66_err_callback.err_inj_cnt),UVM_MEDIUM);
     while(p_sequencer.env.usxgmii_66_err_callback.err_inj_cnt < num_err)
     begin
       #10ns;
       `uvm_info(get_name(), $sformatf("num_err :%d, err_inj_cnt : %d", num_err,p_sequencer.env.usxgmii_66_err_callback.err_inj_cnt), UVM_MEDIUM)
     end
     p_sequencer.env.usxgmii_66_err_callback.enable_injection = 0;
     `else
      p_sequencer.env.mac_err_callback.enable_injection = 1;
      p_sequencer.env.mac_err_callback.err_inj_cnt = 0;
      while(p_sequencer.env.mac_err_callback.err_inj_cnt < num_err)
      begin
       #10ns;
       `uvm_info(get_name(), $sformatf("num_err :%d, err_inj_cnt : %d", num_err,p_sequencer.env.mac_err_callback.err_inj_cnt), UVM_MEDIUM)
      end
     p_sequencer.env.mac_err_callback.enable_injection = 0; 
     `endif
   endtask

   task insert_data_sync_hdr_callback(int num_err);
     `uvm_info("inside task","entering inv sh, with enable_inj=0 & err_inj=0",UVM_MEDIUM);
     `ifdef ETH_MULTI_PORT
     p_sequencer.env.usxgmii_66_err_callback.enable_injection = 1;
     p_sequencer.env.usxgmii_66_err_callback.err_inj_cnt = 0;
     p_sequencer.env.usxgmii_66_err_callback.sync_hdr_type = 2'b10;
     `uvm_info("inside task",$sformatf("changed enable_injection : %0d and err_inf_cnt: %0d",p_sequencer.env.usxgmii_66_err_callback.enable_injection,p_sequencer.env.usxgmii_66_err_callback.err_inj_cnt),UVM_MEDIUM);
     while(p_sequencer.env.usxgmii_66_err_callback.err_inj_cnt < num_err)
     begin
       #10ns;
       `uvm_info(get_name(), $sformatf("num_err :%d, err_inj_cnt : %d", num_err,p_sequencer.env.usxgmii_66_err_callback.err_inj_cnt), UVM_MEDIUM)
     end
     p_sequencer.env.usxgmii_66_err_callback.enable_injection = 0;
     `else
     p_sequencer.env.mac_err_callback.enable_injection = 1;
     p_sequencer.env.mac_err_callback.err_inj_cnt = 0;
     //p_sequencer.env.mac_err_callback.sync_hdr_type = 2'b10;
     while(p_sequencer.env.mac_err_callback.err_inj_cnt < num_err)
     begin
       #10ns;
       `uvm_info(get_name(), $sformatf("num_err :%d, err_inj_cnt : %d", num_err,p_sequencer.env.mac_err_callback.err_inj_cnt), UVM_MEDIUM)
     end
     p_sequencer.env.mac_err_callback.enable_injection = 0;
    `endif
   endtask
     
   task insert_invalid_sync_hdr(seq_var m_seq_var);
     `uvm_info(get_name(), $sformatf("num_invalid_sync_hdr:%d", m_seq_var.num_invalid_sync_hdr), UVM_FULL)
