//----------------------------------------------------------------------------------------
// Task to wait for the xus_timer_done for core/lane
//----------------------------------------------------------------------------------------
task wait_for_hiber_window_done_t ();
  `uvm_info(get_full_name(), $sformatf("Waiting for xus_timer_done"), UVM_LOW)
   @(p_sequencer.env.spy_if.xus_timer_done);
endtask : wait_for_hiber_window_done_t

