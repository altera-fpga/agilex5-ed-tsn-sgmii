class pcs_base_sequence extends eth_base_sequence;
  `uvm_object_utils(pcs_base_sequence)
  function new(string name = "pcs_base_sequence");
    super.new(name);
	`ifdef UVM_POST_VERSION_1_1
     set_automatic_phase_objection(1);
    `endif
 endfunction:new

  virtual task body();
   `uvm_info("body", "Running pcs base sequence ...", UVM_LOW)
  endtask

  class seq_var extends uvm_sequence_item;
    speed_e       speed; 
