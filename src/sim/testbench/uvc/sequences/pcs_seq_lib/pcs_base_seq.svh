    constraint num_lanes_c {
     (speed == _25G)  -> num_lanes inside {1};  
     (speed == _40G)  -> num_lanes inside {[1:4]};  
     (speed == _50G)  -> num_lanes inside {[1:4]};  
     (speed == _100G) -> num_lanes inside {[1:20]};
     (speed == _200G)  -> num_lanes inside {[1:8]};  
     (speed == _400G)  -> num_lanes inside {[1:16]};  
     (!(speed inside{_400G,_200G,_100G,_50G,_40G,_25G})) -> num_lanes inside {1};
    }

    constraint lane_order_c {
      solve lane_0 before lane_1, lane_2, lane_3, lane_4, lane_5, lane_6, lane_7, lane_8, lane_9, lane_10, lane_11, lane_12, lane_13, lane_14, lane_15, lane_16, lane_17, lane_18, lane_19;
    }

    constraint lane_0_c {
     (speed == _25G)  -> lane_0 inside {[0:0]};  
     (speed == _40G)  -> lane_0 inside {[0:3]};  
     (speed == _50G)  -> lane_0 inside {[0:3]};  
     (speed == _100G) -> lane_0 inside {[0:19]};
     (speed == _200G) -> lane_0 inside {[0:7]};
     (speed == _400G) -> lane_0 inside {[0:15]};
     (!(speed inside{_400G,_200G,_100G,_50G,_40G,_25G})) -> lane_0 inside {[0:0]};
    }

    constraint lane_1_c {
     (speed == _40G)  -> lane_1 inside {[0:3]} && (lane_1 != lane_0);  
     (speed == _50G)  -> lane_1 inside {[0:3]} && (lane_1 != lane_0);  
     (speed == _100G) -> lane_1 inside {[0:19]}&& (lane_1 != lane_0);  
     (speed == _200G) -> lane_1 inside {[0:7]}&& (lane_1 != lane_0);  
     (speed == _400G) -> lane_1 inside {[0:15]}&& (lane_1 != lane_0);  
    }

    constraint lane_2_c {
     (speed == _40G)  -> lane_2 inside {[0:3]} && (lane_2 != lane_0) && (lane_2 != lane_1); 
     (speed == _50G)  -> lane_2 inside {[0:3]} && (lane_2 != lane_0) && (lane_2 != lane_1); 
     (speed == _100G) -> lane_2 inside {[0:19]}&& (lane_2 != lane_0) && (lane_2 != lane_1);
     (speed == _200G) -> lane_2 inside {[0:7]}&& (lane_2 != lane_0) && (lane_2 != lane_1);
     (speed == _400G) -> lane_2 inside {[0:15]}&& (lane_2 != lane_0) && (lane_2 != lane_1);
    }

    constraint lane_3_c {
     (speed == _40G)  -> lane_3 inside {[0:3]} && (lane_3 != lane_0) && (lane_3 != lane_1) && (lane_3 != lane_2); 
     (speed == _50G)  -> lane_3 inside {[0:3]} && (lane_3 != lane_0) && (lane_3 != lane_1) && (lane_3 != lane_2); 
     (speed == _100G) -> lane_3 inside {[0:19]}&& (lane_3 != lane_0) && (lane_3 != lane_1) && (lane_3 != lane_2);
     (speed == _200G) -> lane_3 inside {[0:7]}&& (lane_3 != lane_0) && (lane_3 != lane_1) && (lane_3 != lane_2);
     (speed == _400G) -> lane_3 inside {[0:15]}&& (lane_3 != lane_0) && (lane_3 != lane_1) && (lane_3 != lane_2);
    }

    constraint lane_4_c {
      (speed == _100G) -> lane_4 inside {[0:19]} && (lane_4 !=  lane_0) && (lane_4 != lane_1) && (lane_4 != lane_2) && (lane_4 != lane_3);
      (speed == _200G) -> lane_4 inside {[0:7]} && (lane_4 !=  lane_0) && (lane_4 != lane_1) && (lane_4 != lane_2) && (lane_4 != lane_3);
