        //p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB19, 64'hE5F0C0);
        `uvm_fatal(get_name(), $sformatf("Detected wrong lane to insert duplicate am"))
      end
    end
  endcase
endtask :insert_duplicate_am

task insert_invalid_bip(int num_err);
  if((p_sequencer.env.dyn_rcfg_obj_inst.speed == _25G) && (p_sequencer.env.dyn_rcfg_obj_inst.fec_type inside {RSFECKP,RSFECKR})) begin
    p_sequencer.env.xxvsbi_lsbi_bip_corruption_callback.enable_injection = 1;
    p_sequencer.env.xxvsbi_lsbi_bip_corruption_callback.err_inj_cnt = 0;
    while(p_sequencer.env.xxvsbi_lsbi_bip_corruption_callback.err_inj_cnt < num_err)
    begin
      #10ns;
      `uvm_info(get_name(), $sformatf("num_err :%d, err_inj_cnt : %d", num_err,p_sequencer.env.xxvsbi_lsbi_bip_corruption_callback.err_inj_cnt), UVM_MEDIUM)
    end
    p_sequencer.env.xxvsbi_lsbi_bip_corruption_callback.enable_injection = 0;
  end
  else if(p_sequencer.env.dyn_rcfg_obj_inst.speed inside {_200G,_400G}) begin
    p_sequencer.env.g400_bip_corruption_callback.enable_injection = 1;
    p_sequencer.env.g400_bip_corruption_callback.err_inj_cnt = 0;
    while(p_sequencer.env.g400_bip_corruption_callback.err_inj_cnt < num_err)
    begin
      #10ns;
      `uvm_info(get_name(), $sformatf("num_err :%d, err_inj_cnt : %d", num_err,p_sequencer.env.g400_bip_corruption_callback.err_inj_cnt), UVM_MEDIUM)
    end
    p_sequencer.env.g400_bip_corruption_callback.enable_injection = 0;
  end
  else if((p_sequencer.env.dyn_rcfg_obj_inst.fec_type inside {RSFECKP,RSFECKR,LLFEC}) && (p_sequencer.env.dyn_rcfg_obj_inst.speed == _100G)) begin
    p_sequencer.env.rs_fec_bip_corruption_callbacks.enable_injection = 1;
    p_sequencer.env.rs_fec_bip_corruption_callbacks.err_inj_cnt = 0;
    while(p_sequencer.env.rs_fec_bip_corruption_callbacks.err_inj_cnt < num_err)
    begin
      #10ns;
      `uvm_info(get_name(), $sformatf("num_err :%d, err_inj_cnt : %d", num_err,p_sequencer.env.rs_fec_bip_corruption_callbacks.err_inj_cnt), UVM_MEDIUM)
    end
    p_sequencer.env.rs_fec_bip_corruption_callbacks.enable_injection = 0;
  end
  else begin
      `uvm_info(get_name(), $sformatf("Inside txrx_bip_corruption_callback for 50G/40G"), UVM_MEDIUM)
    p_sequencer.env.txrx_bip_corruption_callback.enable_injection = 1;
    p_sequencer.env.txrx_bip_corruption_callback.err_inj_cnt = 0;
    while(p_sequencer.env.txrx_bip_corruption_callback.err_inj_cnt < num_err)
    begin
      #10ns;
      `uvm_info(get_name(), $sformatf("num_err :%d, err_inj_cnt : %d", num_err,p_sequencer.env.txrx_bip_corruption_callback.err_inj_cnt), UVM_MEDIUM)
    end
    p_sequencer.env.txrx_bip_corruption_callback.enable_injection = 0;
  end
endtask

