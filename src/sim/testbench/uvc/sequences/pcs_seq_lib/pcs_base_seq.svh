      end
      else if(m_seq_var.lane_0 == 13) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB13, 64'hE5F0C0);
      end
      else if(m_seq_var.lane_0 == 14) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB14, 64'hE5F0C0);
      end
      else if(m_seq_var.lane_0 == 15) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB15, 64'hE5F0C0);
