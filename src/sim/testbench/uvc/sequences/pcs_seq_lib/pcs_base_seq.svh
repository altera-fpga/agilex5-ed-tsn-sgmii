   task set_lane_reversal(seq_var m_seq_var);
     for(int i=0;i<20;i++) begin
       `uvm_info(get_type_name(), $sformatf("reversal_lane_num[%d]=%d", i, m_seq_var.reversal_lane_num[i]), UVM_LOW)
       p_sequencer.env.`MAC_CFG.csbi_100g_reversal_lane[i] = m_seq_var.reversal_lane_num[i] ;
       `uvm_info(get_type_name(), $sformatf("vip lane_num[%d]=%d", i, p_sequencer.env.`MAC_CFG.csbi_100g_reversal_lane[i]), UVM_LOW)
     end
   
   endtask :set_lane_reversal

   task insert_data_sync_hdr(seq_var m_seq_var);
     `uvm_info(get_name(), $sformatf("num_invalid_sync_hdr:%d", m_seq_var.num_invalid_sync_hdr), UVM_FULL)
     case(m_seq_var.num_lanes)
       1: begin
         if(m_seq_var.lane_0 == 0) begin
           p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_SYNC_HEADER_LANE0, 2'b10);
           m_seq_var.data_sync_hdr_cnt++;
         end
