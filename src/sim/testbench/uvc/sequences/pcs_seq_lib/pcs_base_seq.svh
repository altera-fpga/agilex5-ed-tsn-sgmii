task insert_invalid_am(seq_var m_seq_var);

  `uvm_info(get_name(), $sformatf("num_invalid_am :%d", m_seq_var.num_invalid_am), UVM_FULL)
  `uvm_info(get_type_name(), $sformatf("inserteing invalid_am 100/40G/50G"), UVM_LOW)
  case(m_seq_var.num_lanes)
    1: begin
      if(m_seq_var.lane_0 == 0) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB0, $urandom%32);
      end
      else if(m_seq_var.lane_0 == 1) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB1, $urandom%32);
      end
      else if(m_seq_var.lane_0 == 2) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB2, $urandom%32);
      end
      else if(m_seq_var.lane_0 == 3) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB3, $urandom%32);
      end
      else if(m_seq_var.lane_0 == 4) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB4, $urandom%32);
      end
      else if(m_seq_var.lane_0 == 5) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB5, $urandom%32);
      end
      else if(m_seq_var.lane_0 == 6) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB6, $urandom%32);
      end
      else if(m_seq_var.lane_0 == 7) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB7, $urandom%32);
      end
      else if(m_seq_var.lane_0 == 8) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB8, $urandom%32);
      end
      else if(m_seq_var.lane_0 == 9) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB9, $urandom%32);
      end
      else if(m_seq_var.lane_0 == 10) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB10, $urandom%32);
      end
      else if(m_seq_var.lane_0 == 11) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB11, $urandom%32);
      end
      else if(m_seq_var.lane_0 == 12) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB12, $urandom%32);
      end
      else if(m_seq_var.lane_0 == 13) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB13, $urandom%32);
      end
      else if(m_seq_var.lane_0 == 14) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB14, $urandom%32);
      end
      else if(m_seq_var.lane_0 == 15) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB15, $urandom%32);
      end
      else if(m_seq_var.lane_0 == 16) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB16, $urandom%32);
      end
      else if(m_seq_var.lane_0 == 17) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB17, $urandom%32);
      end
      else if(m_seq_var.lane_0 == 18) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB18, $urandom%32);
      end
      else if(m_seq_var.lane_0 == 19) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB19, $urandom%32);
      end
    end
    2: begin
      //replace am on lane
      if((m_seq_var.lane_0 == 0) || (m_seq_var.lane_1 == 0)) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB0, $urandom%32);
