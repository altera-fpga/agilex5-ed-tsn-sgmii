task insert_invalid_am_50(seq_var m_seq_var); 

  `uvm_info(get_name(), $sformatf("num_invalid_am :%d", m_seq_var.num_invalid_am), UVM_FULL)
  `uvm_info(get_type_name(), $sformatf("inserteing invalid_am 50G"), UVM_LOW)
  case(m_seq_var.num_lanes)
    1: begin
      if(m_seq_var.lane_0 == 0) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_XXVSBI_LSBI_AM_LANE0,24'hfab958);
      end
      else if(m_seq_var.lane_0 == 1) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_XXVSBI_LSBI_AM_LANE1,24'hfab958);
      end
      else if(m_seq_var.lane_0 == 2) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_XXVSBI_LSBI_AM_LANE2,24'hfab958);
      end
      else if(m_seq_var.lane_0 == 3) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_XXVSBI_LSBI_AM_LANE3,24'hfab958);
      end
    end
    2: begin
      if((m_seq_var.lane_0 == 0) || (m_seq_var.lane_1 == 0)) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_XXVSBI_LSBI_AM_LANE0,24'hfab958);
      end
      if((m_seq_var.lane_0 == 1) || (m_seq_var.lane_1 == 1)) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_XXVSBI_LSBI_AM_LANE1,24'hfab958);
      end
      if((m_seq_var.lane_0 == 2) || (m_seq_var.lane_1 == 2)) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_XXVSBI_LSBI_AM_LANE2,24'hfab958);
      end
      if((m_seq_var.lane_0 == 3) || (m_seq_var.lane_1 == 3)) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_XXVSBI_LSBI_AM_LANE3,24'hfab958);
      end
    end
    3: begin
      if((m_seq_var.lane_0 == 0) || (m_seq_var.lane_1 == 0) ||  (m_seq_var.lane_2 == 0)) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_XXVSBI_LSBI_AM_LANE0,24'hfab958);
      end
      if((m_seq_var.lane_0 == 1) || (m_seq_var.lane_1 == 1) ||  (m_seq_var.lane_2 == 1)) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_XXVSBI_LSBI_AM_LANE1,24'hfab958);
      end
      if((m_seq_var.lane_0 == 2) || (m_seq_var.lane_1 == 2) ||  (m_seq_var.lane_2 == 2)) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_XXVSBI_LSBI_AM_LANE2,24'hfab958);
      end
      if((m_seq_var.lane_0 == 3) || (m_seq_var.lane_1 == 3) ||  (m_seq_var.lane_2 == 3)) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_XXVSBI_LSBI_AM_LANE3,24'hfab958);
      end
    end
    4: begin
      if((m_seq_var.lane_0 == 0) || (m_seq_var.lane_1 == 0) ||  (m_seq_var.lane_2 == 0) || (m_seq_var.lane_3 == 0)) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_XXVSBI_LSBI_AM_LANE0,24'hfab958);
      end
      if((m_seq_var.lane_0 == 1) || (m_seq_var.lane_1 == 1) ||  (m_seq_var.lane_2 == 1) || (m_seq_var.lane_3 == 1)) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_XXVSBI_LSBI_AM_LANE1,24'hfab958);
      end
      if((m_seq_var.lane_0 == 2) || (m_seq_var.lane_1 == 2) ||  (m_seq_var.lane_2 == 2) || (m_seq_var.lane_3 == 2)) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_XXVSBI_LSBI_AM_LANE2,24'hfab958);
      end
      if((m_seq_var.lane_0 == 3) || (m_seq_var.lane_1 == 3) ||  (m_seq_var.lane_2 == 3) || (m_seq_var.lane_3 == 3)) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_XXVSBI_LSBI_AM_LANE3,24'hfab958);
      end
    end
  endcase
  endtask //  Insert invalid AM 50G 

task insert_duplicate_am(seq_var m_seq_var);
  //select lane to receive same AM as vlane19
  `uvm_info(get_name(), $sformatf("num_invalid_am :%d", m_seq_var.num_invalid_am), UVM_FULL)
  case(m_seq_var.num_lanes)
    1: begin
      if(m_seq_var.lane_0 == 0) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB0, 64'hE5F0C0);
      end
      else if(m_seq_var.lane_0 == 1) begin
