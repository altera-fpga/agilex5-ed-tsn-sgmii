task insert_invalid_bip_2(seq_var m_seq_var);
  bit [23:0] am[20];
  bit [23:0] am_inv[20];
  bit [23:0] am_err[20];
  bit [7:0] bip[20];
  bit [7:0] bip_err[20];
  //bits correspond to bit-9, 11,17,19, 23 and 24 in the 24-bit alignment code
  //bits 8,10,16,18,22,23 (starting from bit 0)
  //(only these bits are compared in the dut implementation)
  //0 0xC1, 0x68, 0x21, BIP3, 0x3E, 0x97, 0xDE, BIP7
  //1 0x9D, 0x71, 0x8E, BIP3, 0x62, 0x8E, 0x71, BIP7
  //2 0x59, 0x4B, 0xE8, BIP3, 0xA6, 0xB4, 0x17, BIP7
  //3 0x4D, 0x95, 0x7B, BIP3, 0xB2, 0x6A, 0x84, BIP7
  //4 0xF5, 0x07, 0x09, BIP3, 0x0A, 0xF8, 0xF6, BIP7
  //5 0xDD, 0x14, 0xC2, BIP3, 0x22, 0xEB, 0x3D, BIP7
  //6 0x9A, 0x4A, 0x26, BIP3, 0x65, 0xB5, 0xD9, BIP7
  //7 0x7B, 0x45, 0x66, BIP3, 0x84, 0xBA, 0x99, BIP7
  //8 0xA0, 0x24, 0x76, BIP3, 0x5F, 0xDB, 0x89, BIP7
  //9 0x68, 0xC9, 0xFB, BIP3, 0x97, 0x36, 0x04, BIP7
  //10 0xFD, 0x6C, 0x99, BIP3, 0x02, 0x93, 0x66, BIP7
  //11 0xB9, 0x91, 0x55, BIP3, 0x46, 0x6E, 0xAA, BIP7
  //12 0x5C, 0x B9, 0xB2, BIP3, 0xA3, 0x46, 0x4D, BIP7
  //13 0x1A, 0xF8, 0xBD, BIP3, 0xE5, 0x07, 0x42, BIP7
  //14 0x83, 0xC7, 0xCA, BIP3, 0x7C, 0x38, 0x35, BIP7
  //15 0x35, 0x36, 0xCD, BIP3, 0xCA, 0xC9, 0x32, BIP7
  //16 0xC4, 0x31, 0x4C, BIP3, 0x3B, 0xCE, 0xB3, BIP7
  //17 0xAD, 0xD6, 0xB7, BIP3, 0x52, 0x29, 0x48, BIP7
  //18 0x5F, 0x66, 0x2A, BIP3, 0xA0, 0x99, 0xD5, BIP7
  //19 0xC0, 0xF0, 0xE5, BIP3, 0x3F, 0x0F, 0x1A, BIP7
 
 
  `uvm_info(get_name(), $sformatf("num_invalid_am :%d", m_seq_var.num_invalid_am), UVM_LOW)
  //error_0_8 = 24'hC1_68_21 | 24'h00_01_00;      //bit 8: 0000_0000_0000_0001_0000_0000
  //error_0_10 = 24'hC1_68_21 | 24'h00_04_00;      //bit 10: 0000_0000_0000_0100_0000_0000
  //error_0_16 = 24'hC1_68_21 & 24'hFE_FF_FF;      //bit 16: 1111_1110_1111_1111_1111_1111
  //error_0_18 = 24'hC1_68_21 | 24'hFE_FF_FF;      //bit 18: 0000_0100_0000_0000_0000_0000

  am[0] = 24'h21_68_C1;
  am_inv[0] = 24'hDE_97_3E;
  bip[0] = $urandom()%256; 
  bip_err[0] = $urandom()%256; 

  am[1] = 24'h8E_71_9D;
  am_inv[1] = 24'h71_8E_62;
  bip[1] = $urandom()%256; 
  bip_err[1] = $urandom()%256; 
  
  am[2] = 24'hE8_4B_59;
  am_inv[2] = 24'h17_B4_A6;
  bip[2] = $urandom()%256; 
  bip_err[2] = $urandom()%256; 

  am[3] = 24'h7B_95_4D;
  am_inv[3] = 24'h84_6A_B2;
  bip[3] = $urandom()%256; 
  bip_err[3] = $urandom()%256; 

  am[4] = 24'h09_07_F5;
  am_inv[4] = 24'hF6_F8_0A;
  bip[4] = $urandom()%256; 
  bip_err[4] = $urandom()%256; 

  am[5] = 24'hC2_14_DD;
  am_inv[5] = 24'h3D_EB_22;
  bip[5] = $urandom()%256; 
  bip_err[5] = $urandom()%256; 

  am[6] = 24'h26_4A_9A;
  am_inv[6] = 24'hD9_B5_65;
  bip[6] = $urandom()%256; 
  bip_err[6] = $urandom()%256; 

  am[7] = 24'h66_45_7B;
  am_inv[7] = 24'h99_BA_84;
  bip[7] = $urandom()%256; 
  bip_err[7] = $urandom()%256; 

  am[8] = 24'h76_24_A0;
  am_inv[8] = 24'h89_DB_5F;
  bip[8] = $urandom()%256; 
  bip_err[8] = $urandom()%256; 

  am[9] = 24'hFB_C9_68;
  am_inv[9] = 24'h04_36_97;
  bip[9] = $urandom()%256; 
  bip_err[9] = $urandom()%256; 

  am[10] = 24'h99_6C_FD;
  am_inv[10] = 24'h66_93_02;
  bip[10] = $urandom()%256; 
  bip_err[10] = $urandom()%256;
 
  am[11] = 24'h55_91_B9;
  am_inv[11] = 24'hAA_6E_46;
  bip[11] = $urandom()%256; 
  bip_err[11] = $urandom()%256;
 
  am[12] = 24'hB2_B9_5C;
  am_inv[12] = 24'h4D_46_A3;
  bip[12] = $urandom()%256; 
  bip_err[12] = $urandom()%256;
 
  am[13] = 24'hBD_F8_1A;
  am_inv[13] = 24'h42_07_E5;
  bip[13] = $urandom()%256; 
  bip_err[13] = $urandom()%256;

  am[14] = 24'hCA_C7_83;
  am_inv[14] = 24'h35_38_7C;
  bip[14] = $urandom()%256; 
  bip_err[14] = $urandom()%256;

  am[15] = 24'hCD_36_35;
  am_inv[15] = 24'h32_C9_CA;
  bip[15] = $urandom()%256; 
  bip_err[15] = $urandom()%256;

  am[16] = 24'h4C_31_C4;
  am_inv[16] = 24'hB3_CE_3B;
  bip[16] = $urandom()%256; 
  bip_err[16] = $urandom()%256;

  //am[17] = 24'hAD_D6_B7;
  am[17] = 24'hB7_D6_AD;
  am_inv[17] = 24'h48_29_52;
  bip[17] = $urandom()%256; 
  bip_err[17] = $urandom()%256;

  am[18] = 24'h2A_66_5F;
  am_inv[18] = 24'hD5_99_A0;
  bip[18] = $urandom()%256; 
  bip_err[18] = $urandom()%256;

  am[19] = 24'hE5_F0_C0;
  am_inv[19] = 24'h1A_0F_3F;
  bip[19] = $urandom()%256; 
  bip_err[19] = $urandom()%256;



  case(m_seq_var.num_lanes)
    1: begin
      if(m_seq_var.lane_0 == 0) begin
        //p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB0, {am[0], bip[0], am_inv[0], bip_err[0]});
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB0, {bip_err[0],am_inv[0], bip[0], am[0]});
      end
      else if(m_seq_var.lane_0 == 1) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB19, {bip_err[19],am_inv[19], bip[19], am[19]});
      end
      else if(m_seq_var.lane_0 == 2) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB2, {bip_err[2],am_inv[2], bip[2], am[2]});
      end
      else if(m_seq_var.lane_0 == 3) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB3, {bip_err[3],am_inv[3], bip[3], am[3]});
      end
      else if(m_seq_var.lane_0 == 4) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB4, {bip_err[4],am_inv[4], bip[4], am[4]});
      end
      else if(m_seq_var.lane_0 == 5) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB5, {bip_err[5],am_inv[5], bip[5], am[5]});
      end
      else if(m_seq_var.lane_0 == 6) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB6, {bip_err[6],am_inv[6], bip[6], am[6]});
      end
      else if(m_seq_var.lane_0 == 7) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB7, {bip_err[7],am_inv[7], bip[7], am[7]});
      end
      else if(m_seq_var.lane_0 == 8) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB8, {bip_err[8],am_inv[8], bip[8], am[8]});
      end
      else if(m_seq_var.lane_0 == 9) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB9, {bip_err[9],am_inv[9], bip[9], am[9]});
      end
      else if(m_seq_var.lane_0 == 10) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB19, {bip_err[19],am_inv[19], bip[19], am[19]});
      end
      else if(m_seq_var.lane_0 == 11) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB19, {bip_err[19],am_inv[19], bip[19], am[19]});
      end
      else if(m_seq_var.lane_0 == 12) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB19, {bip_err[19],am_inv[19], bip[19], am[19]});
      end
      else if(m_seq_var.lane_0 == 13) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB19, {bip_err[19],am_inv[19], bip[19], am[19]});
      end
      else if(m_seq_var.lane_0 == 14) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB19, {bip_err[19],am_inv[19], bip[19], am[19]});
      end
      else if(m_seq_var.lane_0 == 15) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB19, {bip_err[19],am_inv[19], bip[19], am[19]});
      end
      else if(m_seq_var.lane_0 == 16) begin
        p_sequencer.env.ts_tasks_if.do_drv_err(`ETH_10G_MULTILANE_REPLACE_VLAB19, {bip_err[19],am_inv[19], bip[19], am[19]});
      end
      else if(m_seq_var.lane_0 == 17) begin
