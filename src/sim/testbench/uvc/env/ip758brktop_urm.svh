      //
      // User defined cross coverage declarations
      //
      `include "ip758brktop_urm_cover_user.svh"
   endgroup : cg_fields

   //---------------------------------------------------------------------------
   // Covergroup for address maps
   //---------------------------------------------------------------------------
   //
   // Variable which have the address of config_map
   //
   local uvm_reg_addr_t m_config_map_offset;
   //
   // Covergroup definition for address map access of config_map
   //
   covergroup cg_config_map_access;
      option.per_instance = 1;
      access_cp : coverpoint m_config_map_offset {
         bins serdes_lane_car_lane0_reg_1              = {`UVM_REG_ADDR_WIDTH'h40000};
         bins serdes_lane_car_lane0_reg_2              = {`UVM_REG_ADDR_WIDTH'h40004};
         bins serdes_lane_car_lane0_reg_3              = {`UVM_REG_ADDR_WIDTH'h40008};
         bins serdes_lane_car_lane0_reg_4              = {`UVM_REG_ADDR_WIDTH'h4000C};
         bins serdes_lane_car_lane0_reg_5              = {`UVM_REG_ADDR_WIDTH'h40034};
         bins serdes_lane_car_lane0_reg_6              = {`UVM_REG_ADDR_WIDTH'h40038};
         bins serdes_lane_car_lane0_reg_7              = {`UVM_REG_ADDR_WIDTH'h4003C};
         bins serdes_lane_car_lane0_reg_8              = {`UVM_REG_ADDR_WIDTH'h40044};
         bins serdes_lane_car_lane0_reg_9              = {`UVM_REG_ADDR_WIDTH'h40048};
         bins serdes_lane_dsp_adapt_lane0_reg_1        = {`UVM_REG_ADDR_WIDTH'h40800};
         bins serdes_lane_dsp_adapt_lane0_reg_2        = {`UVM_REG_ADDR_WIDTH'h40808};
         bins serdes_lane_dsp_adapt_lane0_reg_3        = {`UVM_REG_ADDR_WIDTH'h4080C};
         bins serdes_lane_dsp_adapt_lane0_reg_4        = {`UVM_REG_ADDR_WIDTH'h40810};
