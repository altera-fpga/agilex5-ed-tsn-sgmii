   endfunction : build
   //
   // Function: sample
   //    Implement the sample method for automatic sampling when a block
   //    access occurs
   //
   // Parameters:
   //    - offset  : Block's offset value
   //    - is_read : Indicates if the accss is READ
   //    - map     : Handle to the address map
   //
   virtual function void sample (
      uvm_reg_addr_t offset,
      bit            is_read,
      uvm_reg_map    map
   );
      super.sample(offset, is_read, map);
      if (has_coverage(UVM_CVR_FIELD_VALS))
      begin
         cg_fields.sample();
      end
      if (get_coverage(UVM_CVR_ADDR_MAP))
      begin
         case (map.get_name())
         "config_map":
         begin
            m_config_map_offset = offset;
            cg_config_map_access.sample();
         end
         "user_map":
         begin
            m_user_map_offset = offset;
            cg_user_map_access.sample();
         end
         default:;
         endcase
      end
   endfunction : sample

endclass : gdr_barak_quad_avmm_cfgcsr_urm

