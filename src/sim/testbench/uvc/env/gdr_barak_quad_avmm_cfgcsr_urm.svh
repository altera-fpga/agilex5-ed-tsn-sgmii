   //---------------------------------------------------------------------------
   // UVM Methods
   //---------------------------------------------------------------------------
   //
   // Function: new
   //    Class contructor
   //
   // Parameters:
   //    - name : class's string based name
   //
   function new (string n = "gdr_barak_quad_avmm_cfgcsr_urm");
      super.new(n, build_coverage(UVM_CVR_ALL));
      if (has_coverage(UVM_CVR_FIELD_VALS))
      begin
         cg_fields = new();
      end
      if (has_coverage(UVM_CVR_ADDR_MAP))
      begin
         cg_config_map_access   = new();
         cg_user_map_access     = new();
      end
   endfunction : new
