/*-----------------------------------------------------------------------------------------------
---  eth_f_all_rsfec_core_cfg_17_urm Register Definition
-----------------------------------------------------------------------------------------------*/
class eth_f_all_rsfec_core_cfg_17_urm  extends uvm_reg;

      `uvm_object_utils(eth_f_all_rsfec_core_cfg_17_urm  )

      rand uvm_reg_field frac;
      rand uvm_reg_field dual_fec_am_en;
      rand uvm_reg_field two_lane_en;
      rand uvm_reg_field dual_fec_en;
      rand uvm_reg_field pcs_scr_dis;
      rand uvm_reg_field inv_uniq_am_pat;
      rand uvm_reg_field eng_enter_align;
      rand uvm_reg_field eng_exit_align;
      rand uvm_reg_field eng_test;
      
      typedef enum bit [2:0] {
      ln1111 = 3'h0,
      ln112 = 3'h1,
      ln211 = 3'h2,
      ln22 = 3'h3,
      ln4 = 3'h4,
      ln8 = 3'h5,
      ln16 = 3'h6
       }  frac_enum;
       
      		
      covergroup cg_field_values ();
          option.per_instance = 1;
          frac_value : coverpoint frac.value {
             bins ln1111 = {ln1111 };
             bins ln112 = {ln112 };
             bins ln211 = {ln211 };
             bins ln22 = {ln22 };
             bins ln4 = {ln4 };
             bins ln8 = {ln8 };
             bins ln16 = {ln16 };
             illegal_bins bad = default;
          }
          dual_fec_am_en_value : coverpoint dual_fec_am_en.value {
             bins all[2] = {[1'h0:1'h1]};
             illegal_bins bad = default;
          }
          two_lane_en_value : coverpoint two_lane_en.value {
             bins all[2] = {[1'h0:1'h1]};
             illegal_bins bad = default;
          }
          dual_fec_en_value : coverpoint dual_fec_en.value {
             bins all[2] = {[1'h0:1'h1]};
             illegal_bins bad = default;
