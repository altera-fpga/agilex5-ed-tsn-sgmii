             bins ln1111 = {ln1111 };
             bins ln112 = {ln112 };
             bins ln211 = {ln211 };
             bins ln22 = {ln22 };
             bins ln4 = {ln4 };
             bins ln8 = {ln8 };
             bins ln16 = {ln16 };
             illegal_bins bad = default;
          }
          dual_fec_am_en_value : coverpoint dual_fec_am_en.value {
             bins all[2] = {[1'h0:1'h1]};
             illegal_bins bad = default;
          }
